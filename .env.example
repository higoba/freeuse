# SMTP da caixa de e-mail usada pelo formulário de contato.
# Guarde a senha somente nas variáveis de ambiente do servidor (nunca no Git).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@freeuse.store
SMTP_PASSWORD=
CONTACT_TO=contato@freeuse.store

# Chave da Google Maps Platform (Routes API e Geocoding).
# Necessária para calcular automaticamente distância precisa e valores de pedágios na calculadora de viagem.
GOOGLE_MAPS_API_KEY=

