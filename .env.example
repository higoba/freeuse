# IDs de três unidades de anúncio criadas no painel do Google AdSense.
# Deixe em branco até criar as unidades; não invente valores.
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_MIDDLE=
NEXT_PUBLIC_ADSENSE_SLOT_BOTTOM=
# Aliases anteriores, usados como posição central quando configurados.
NEXT_PUBLIC_ADSENSE_SLOT_HOME=
NEXT_PUBLIC_ADSENSE_SLOT_TOOLS=
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=

# SMTP da caixa de e-mail usada pelo formulário de contato.
# Guarde a senha somente nas variáveis de ambiente do servidor (nunca no Git).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=contato@freeuse.store
SMTP_PASSWORD=
CONTACT_TO=contato@freeuse.store
